<Window x:Class="PracticaPOLESTAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polestar | Electric Performance"
        Height="800" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7">

    <Window.Resources>

        <!-- ANIMACION DE BOTONES -->
        <Style x:Key="ButtonHoverStyle" TargetType="Button">
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0.72" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ANIMACION DE TARJETAS -->
        <Style x:Key="CardHoverStyle" TargetType="Border">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                To="-5" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                To="0" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ANIMACION DE ZOOM EN IMAGENES -->
        <Style x:Key="ImageZoomStyle" TargetType="Image">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.05" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="#F7F7F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA COMUN -->
        <Border Grid.Row="0" Background="#E8E8E8"
                BorderBrush="#D5D5D5" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/polestar-logo.png"
                           Height="38" Width="38" Stretch="Uniform"
                           Margin="0,0,12,0"/>
                    <TextBlock Text="POLESTAR" FontSize="23"
                               FontWeight="SemiBold" Foreground="#171717"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonHoverStyle}"
                            Content="INICIO" Click="Inicio_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#171717" FontSize="12"
                            FontWeight="SemiBold" Padding="15,10"
                            Cursor="Hand"/>
                    <Button Style="{StaticResource ButtonHoverStyle}"
                            Content="VEHÍCULOS" Click="Vehiculos_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#171717" FontSize="12"
                            FontWeight="SemiBold" Padding="15,10"
                            Cursor="Hand"/>
                    <Button Style="{StaticResource ButtonHoverStyle}"
                            Content="MI CUENTA" Click="Cuenta_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#171717" FontSize="12"
                            FontWeight="SemiBold" Padding="15,10"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO DE LAS PANTALLAS -->
        <Grid Grid.Row="1">

            <!-- INICIO -->
            <Grid x:Name="HomePage" Visibility="Visible"
                  Margin="30,15,30,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.45*"/>
                    <RowDefinition Height="0.9*"/>
                </Grid.RowDefinitions>

                <!-- BANNER Y EXPERIENCIAS EN DOS COLUMNAS -->
                <Border Grid.Row="0" Background="#202020"
                        CornerRadius="3" Padding="22"
                        Margin="0,0,0,12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BANNER PRINCIPAL: IZQUIERDA -->
                        <Grid Grid.Column="0" Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ELECTRIC PERFORMANCE"
                                           Foreground="#AAAAAA"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,9"/>

                                <TextBlock Text="El futuro de la conducción."
                                           Foreground="White"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <TextBlock
                                    Text="Descubre una nueva forma de entender la movilidad eléctrica."
                                    Foreground="#CCCCCC"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,18"/>

                                <Border Background="#303030"
                                        CornerRadius="3"
                                        ClipToBounds="True"
                                        Margin="0,0,0,15">
                                    <Image Source="/Assets/Images/polestar-2.png"
                                           Stretch="Uniform"
                                           MaxHeight="145"
                                           Style="{StaticResource ImageZoomStyle}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Row="1"
                                    Style="{StaticResource ButtonHoverStyle}"
                                    Content="DESCUBRIR MODELOS"
                                    Click="Vehiculos_Click"
                                    Background="#F5F5F5"
                                    Foreground="#171717"
                                    BorderThickness="0"
                                    Padding="15,9"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"/>
                        </Grid>

                        <!-- EXPERIENCIAS: DERECHA -->
                        <Grid x:Name="CampaignContent"
                              Grid.Column="1"
                              Margin="18,0,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,12">
                                <TextBlock Text="EXPERIENCIAS POLESTAR"
                                           Foreground="#AAAAAA"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="Descubre nuevas experiencias"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- TEXTO E IMAGEN DE LA CAMPAÑA -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">

                                    <TextBlock x:Name="CampaignCategory"
                                               Text="01 / EXPERIENCIA"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#AAAAAA"
                                               Margin="0,0,0,8"/>

                                    <TextBlock x:Name="CampaignTitle"
                                               Text="Tu primera experiencia eléctrica"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock x:Name="CampaignDescription"
                                               Text="Descubre cómo se siente conducir un Polestar y conoce nuestra gama de vehículos."
                                               FontSize="11"
                                               Foreground="#CCCCCC"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,14"/>

                                    <Button Style="{StaticResource ButtonHoverStyle}"
                                            Content="DESCUBRIR MÁS"
                                            Click="Vehiculos_Click"
                                            Background="#F5F5F5"
                                            Foreground="#171717"
                                            BorderThickness="0"
                                            Padding="11,8"
                                            HorizontalAlignment="Left"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Cursor="Hand"/>
                                </StackPanel>

                                <!-- IMAGEN 16:9 -->
                                <Viewbox Grid.Column="1"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxWidth="360"
                                         MaxHeight="203">
                                    <Border Width="360"
                                            Height="202.5"
                                            Background="#303030"
                                            CornerRadius="2"
                                            ClipToBounds="True">
                                        <Image x:Name="CampaignImage"
                                               Source="/Assets/Images/campana-experiencia.jpg"
                                               Stretch="Uniform"
                                               Style="{StaticResource ImageZoomStyle}"/>
                                    </Border>
                                </Viewbox>
                            </Grid>

                            <!-- CONTROLES DEL CARRUSEL -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CampaignNumber"
                                           Text="01 / 03"
                                           FontSize="9"
                                           Foreground="#AAAAAA"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource ButtonHoverStyle}"
                                        Content="←"
                                        Click="AnteriorCampana_Click"
                                        Background="#404040"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Width="32"
                                        Height="27"
                                        Margin="0,0,5,0"
                                        FontSize="14"
                                        Cursor="Hand"/>

                                <Button Grid.Column="2"
                                        Style="{StaticResource ButtonHoverStyle}"
                                        Content="→"
                                        Click="SiguienteCampana_Click"
                                        Background="#F5F5F5"
                                        Foreground="#171717"
                                        BorderThickness="0"
                                        Width="32"
                                        Height="27"
                                        FontSize="14"
                                        Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- VEHICULOS EN LA ZONA INFERIOR -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="DESCUBRE NUESTRA GAMA"
                                   Foreground="#777777"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Nuestros vehículos"
                                   Foreground="#171717"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- POLESTAR 2 -->
                        <Border Grid.Column="0" Background="White"
                                BorderBrush="#E5E5E5" BorderThickness="1"
                                CornerRadius="3" Padding="14"
                                Margin="0,0,6,0"
                                Style="{StaticResource CardHoverStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="/Assets/Images/polestar-2.png"
                                       Stretch="Uniform"
                                       Style="{StaticResource ImageZoomStyle}"/>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Polestar 2"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#171717"/>
                                    <TextBlock Text="Fastback eléctrico"
                                               FontSize="11"
                                               Foreground="#777777"
                                               Margin="0,2,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Desde 48.200 €"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#171717"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ButtonHoverStyle}"
                                                Content="VER MODELO"
                                                Click="Polestar2_Click"
                                                Background="#171717"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="9,7"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- POLESTAR 3 -->
                        <Border Grid.Column="1" Background="White"
                                BorderBrush="#E5E5E5" BorderThickness="1"
                                CornerRadius="3" Padding="14"
                                Margin="3,0"
                                Style="{StaticResource CardHoverStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="/Assets/Images/polestar-3.png"
                                       Stretch="Uniform"
                                       Style="{StaticResource ImageZoomStyle}"/>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Polestar 3"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#171717"/>
                                    <TextBlock Text="SUV eléctrico"
                                               FontSize="11"
                                               Foreground="#777777"
                                               Margin="0,2,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Desde 81.900 €"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#171717"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ButtonHoverStyle}"
                                                Content="VER MODELO"
                                                Click="Polestar3_Click"
                                                Background="#171717"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="9,7"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- POLESTAR 4 -->
                        <Border Grid.Column="2" Background="White"
                                BorderBrush="#E5E5E5" BorderThickness="1"
                                CornerRadius="3" Padding="14"
                                Margin="6,0,0,0"
                                Style="{StaticResource CardHoverStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="/Assets/Images/polestar-4.png"
                                       Stretch="Uniform"
                                       Style="{StaticResource ImageZoomStyle}"/>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Polestar 4"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#171717"/>
                                    <TextBlock Text="SUV coupé eléctrico"
                                               FontSize="11"
                                               Foreground="#777777"
                                               Margin="0,2,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Desde 55.600 €"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#171717"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ButtonHoverStyle}"
                                                Content="VER MODELO"
                                                Click="Polestar4_Click"
                                                Background="#171717"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="9,7"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- GALERIA DE VEHICULOS -->
            <Grid x:Name="VehiclesPage"
                  Visibility="Collapsed"
                  Margin="30,25,30,25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="NUESTRA GAMA"
                               Foreground="#777777"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBlock Text="Descubre nuestros vehículos"
                               Foreground="#171717"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBlock
                        Text="Diseño escandinavo, tecnología avanzada y movilidad eléctrica."
                        Foreground="#777777"
                        FontSize="13"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- POLESTAR 2 -->
                    <Border Grid.Column="0" Background="White"
                            BorderBrush="#E5E5E5" BorderThickness="1"
                            CornerRadius="3" Padding="18"
                            Margin="0,0,8,0"
                            Style="{StaticResource CardHoverStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F5F5F5"
                                    CornerRadius="2" ClipToBounds="True"
                                    Margin="0,0,0,15">
                                <Viewbox Stretch="Uniform"
                                         MaxHeight="230" MaxWidth="420">
                                    <Image Source="/Assets/Images/polestar-2.png"
                                           Width="420" Height="236.25"
                                           Stretch="Uniform"
                                           Style="{StaticResource ImageZoomStyle}"/>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="POLESTAR 2"
                                           FontSize="11" Foreground="#777777"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Una nueva forma de avanzar."
                                           FontSize="21" Foreground="#171717"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="Fastback 100% eléctrico que combina un diseño escandinavo moderno con una conducción dinámica y tecnología avanzada."
                                    FontSize="12" Foreground="#777777"
                                    TextWrapping="Wrap" LineHeight="19"
                                    Margin="0,0,0,12"/>
                                <TextBlock Text="Desde 48.200 €"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#171717"
                                           Margin="0,0,0,12"/>
                                <Button Style="{StaticResource ButtonHoverStyle}"
                                        Content="VER MODELO"
                                        Click="Polestar2_Click"
                                        Background="#171717" Foreground="White"
                                        BorderThickness="0" Padding="13,10"
                                        HorizontalAlignment="Left"
                                        FontSize="10" FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- POLESTAR 3 -->
                    <Border Grid.Column="1" Background="White"
                            BorderBrush="#E5E5E5" BorderThickness="1"
                            CornerRadius="3" Padding="18"
                            Margin="4,0"
                            Style="{StaticResource CardHoverStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F5F5F5"
                                    CornerRadius="2" ClipToBounds="True"
                                    Margin="0,0,0,15">
                                <Viewbox Stretch="Uniform"
                                         MaxHeight="230" MaxWidth="420">
                                    <Image Source="/Assets/Images/polestar-3.png"
                                           Width="420" Height="236.25"
                                           Stretch="Uniform"
                                           Style="{StaticResource ImageZoomStyle}"/>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="POLESTAR 3"
                                           FontSize="11" Foreground="#777777"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Lujo eléctrico en estado puro."
                                           FontSize="21" Foreground="#171717"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="SUV eléctrico que combina espacio interior, tecnología avanzada y un diseño escandinavo elegante."
                                    FontSize="12" Foreground="#777777"
                                    TextWrapping="Wrap" LineHeight="19"
                                    Margin="0,0,0,12"/>
                                <TextBlock Text="Desde 81.900 €"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#171717"
                                           Margin="0,0,0,12"/>
                                <Button Style="{StaticResource ButtonHoverStyle}"
                                        Content="VER MODELO"
                                        Click="Polestar3_Click"
                                        Background="#171717" Foreground="White"
                                        BorderThickness="0" Padding="13,10"
                                        HorizontalAlignment="Left"
                                        FontSize="10" FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- POLESTAR 4 -->
                    <Border Grid.Column="2" Background="White"
                            BorderBrush="#E5E5E5" BorderThickness="1"
                            CornerRadius="3" Padding="18"
                            Margin="8,0,0,0"
                            Style="{StaticResource CardHoverStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F5F5F5"
                                    CornerRadius="2" ClipToBounds="True"
                                    Margin="0,0,0,15">
                                <Viewbox Stretch="Uniform"
                                         MaxHeight="230" MaxWidth="420">
                                    <Image Source="/Assets/Images/polestar-4.png"
                                           Width="420" Height="236.25"
                                           Stretch="Uniform"
                                           Style="{StaticResource ImageZoomStyle}"/>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="POLESTAR 4"
                                           FontSize="11" Foreground="#777777"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Una experiencia diferente."
                                           FontSize="21" Foreground="#171717"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="SUV coupé eléctrico que destaca por su diseño atrevido, su silueta deportiva y su carácter innovador."
                                    FontSize="12" Foreground="#777777"
                                    TextWrapping="Wrap" LineHeight="19"
                                    Margin="0,0,0,12"/>
                                <TextBlock Text="Desde 55.600 €"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#171717"
                                           Margin="0,0,0,12"/>
                                <Button Style="{StaticResource ButtonHoverStyle}"
                                        Content="VER MODELO"
                                        Click="Polestar4_Click"
                                        Background="#171717" Foreground="White"
                                        BorderThickness="0" Padding="13,10"
                                        HorizontalAlignment="Left"
                                        FontSize="10" FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- MI CUENTA -->
            <ScrollViewer x:Name="AccountPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="600">
                    <Border Width="440" Padding="40"
                            Background="White"
                            BorderBrush="#E5E5E5" BorderThickness="1"
                            CornerRadius="3"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="MI CUENTA" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Bienvenido de nuevo."
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="#171717"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Accede a tu cuenta Polestar."
                                       FontSize="14" Foreground="#777777"
                                       Margin="0,0,0,30"/>
                            <TextBlock Text="CORREO ELECTRÓNICO"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#171717"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="EmailTextBox" Height="42"
                                     FontSize="14" Padding="10"
                                     BorderBrush="#D5D5D5"
                                     BorderThickness="1"
                                     Margin="0,0,0,20"/>
                            <TextBlock Text="CONTRASEÑA"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#171717"
                                       Margin="0,0,0,8"/>
                            <PasswordBox x:Name="PasswordInput" Height="42"
                                         FontSize="14" Padding="10"
                                         BorderBrush="#D5D5D5"
                                         BorderThickness="1"
                                         Margin="0,0,0,25"/>
                            <Button Style="{StaticResource ButtonHoverStyle}"
                                    Content="INICIAR SESIÓN"
                                    Click="Login_Click" Height="45"
                                    Background="#171717" Foreground="White"
                                    BorderThickness="0" FontSize="11"
                                    FontWeight="Bold" Cursor="Hand"/>
                            <TextBlock x:Name="LoginMessage"
                                       FontSize="12" Foreground="#B00020"
                                       TextWrapping="Wrap"
                                       Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- FICHA DE DETALLE -->
            <ScrollViewer x:Name="DetailPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,40,40,40">

                    <Button Style="{StaticResource ButtonHoverStyle}"
                            Content="← VOLVER A VEHÍCULOS"
                            Click="Vehiculos_Click"
                            Background="Transparent"
                            Foreground="#171717"
                            BorderThickness="0" FontSize="11"
                            FontWeight="Bold"
                            HorizontalAlignment="Left"
                            Padding="0,10" Margin="0,0,0,25"
                            Cursor="Hand"/>

                    <Border Background="White" BorderBrush="#E5E5E5"
                            BorderThickness="1" CornerRadius="3"
                            Padding="35">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,30,0">
                                <TextBlock Text="DESCUBRE POLESTAR"
                                           FontSize="12" Foreground="#777777"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,15"/>
                                <TextBlock x:Name="DetailTitle"
                                           Text="Polestar 2" FontSize="34"
                                           FontWeight="SemiBold"
                                           Foreground="#171717"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailSubtitle"
                                           Text="Fastback 100% eléctrico"
                                           FontSize="16" Foreground="#777777"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,15"/>
                                <TextBlock x:Name="DetailPrice"
                                           Text="48.200 €" FontSize="27"
                                           FontWeight="SemiBold"
                                           Foreground="#171717"
                                           Margin="0,0,0,25"/>
                                <TextBlock Text="PRESTACIONES"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#777777"
                                           Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                Margin="0,0,10,15">
                                        <TextBlock x:Name="DetailPower"
                                                   Text="272 CV" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="#171717"/>
                                        <TextBlock Text="Potencia"
                                                   FontSize="11"
                                                   Foreground="#777777"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Margin="0,0,0,15">
                                        <TextBlock x:Name="DetailRange"
                                                   Text="554 km" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="#171717"/>
                                        <TextBlock Text="Autonomía WLTP"
                                                   FontSize="11"
                                                   Foreground="#777777"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock x:Name="DetailAcceleration"
                                                   Text="6,4 s" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="#171717"/>
                                        <TextBlock Text="0-100 km/h"
                                                   FontSize="11"
                                                   Foreground="#777777"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="DetailDescription"
                                           Text="Descripción del vehículo."
                                           FontSize="13" Foreground="#555555"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F0F0F0"
                                    CornerRadius="3" ClipToBounds="True"
                                    MinHeight="300">
                                <Image x:Name="DetailImage"
                                       Source="/Assets/Images/polestar-2.png"
                                       Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock
                        Text="Los datos de autonomía corresponden al ciclo WLTP. El precio y las prestaciones pueden variar según la configuración y las ofertas disponibles."
                        FontSize="11" Foreground="#888888"
                        TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
